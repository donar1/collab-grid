# CollabGrid 环境变量配置示例
# 复制此文件为 .env 并修改对应值

# 基础配置
NODE_ENV=development
PORT=3000

# 安全（生产环境必须修改）
# JWT_SECRET: 必须至少 32 位随机字符串，否则服务拒绝启动
# 生成命令: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-me-to-a-random-string-at-least-32-chars
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# CSRF 保护：NODE_ENV=production 时自动启用，前端必须携带 X-CSRF-Token header
# 开发环境（NODE_ENV=development）CSRF 校验自动跳过
# CSRF_TOKEN 通过 Set-Cookie 下发，前端从 cookie 读取后放入 header

# 数据库引擎：sqlite | postgresql
DB_ENGINE=sqlite
DB_PATH=./data/collab-grid.db
PUBLIC_DB_PATH=./data/public.db
DB_READ_POOL_SIZE=4

# PostgreSQL（DB_ENGINE=postgresql 时生效）
PG_HOST=localhost
PG_PORT=5432
PG_DATABASE=collabgrid
PG_USER=postgres
PG_PASSWORD=
PG_POOL_MAX=20
PG_IDLE_TIMEOUT_MS=30000
PG_CONNECTION_TIMEOUT_MS=5000
# 读写分离（可选，留空则读写都走主库）
# PG_READ_HOST=
# PG_READ_PORT=5432
# PG_READ_POOL_MAX=10

# 日志
LOG_LEVEL=info
LOG_TO_FILE=false
LOG_DIR=./logs

# 速率限制
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=20
AUTH_RATE_LIMIT_MAX=10

# 同步
SYNC_MAX_EVENTS=500

# 上传
UPLOAD_MAX_SIZE=10485760

# 调度器
SCHEDULER_ENABLED=true
SCHEDULER_INTERVAL_MINUTES=1

# 默认管理员（生产环境必须修改）
DEFAULT_ADMIN_EMAIL=admin@collabgrid.local
DEFAULT_ADMIN_DISPLAY_NAME=系统管理员
DEFAULT_ADMIN_PASSWORD=Admin@123456

# SMTP Alert (optional)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
ALERT_RECIPIENTS=
