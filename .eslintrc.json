{
  "env": {
    "browser": true,
    "commonjs": true,
    "es2022": true,
    "node": true,
    "mocha": true
  },
  "extends": "eslint:recommended",
  "parserOptions": {
    "ecmaVersion": 2022
  },
  "rules": {
    "no-unused-vars": ["warn", { "argsIgnorePattern": "^_" }],
    "no-console": "off",
    "no-var": "warn",
    "prefer-const": "warn",
    "eqeqeq": ["warn", "always"],
    "curly": ["warn", "multi-line"],
    "no-throw-literal": "warn",
    "prefer-promise-reject-errors": "warn"
  },
  "ignorePatterns": [
    "node_modules/",
    "data/",
    "backups/",
    "logs/",
    "public/modules/*.js"
  ]
}
